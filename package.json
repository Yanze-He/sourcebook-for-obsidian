{
  "name": "sourcebook-obsidian",
  "version": "0.2.3",
  "private": true,
  "description": "Local-first material Books with live Obsidian references and explicit AI handoff snapshots.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "check:offline": "node scripts/typecheck-offline.cjs",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-release.cjs",
    "package": "node scripts/package.cjs",
    "install:test": "node scripts/install.cjs",
    "pretest": "node scripts/build.cjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "obsidian": "1.14.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
